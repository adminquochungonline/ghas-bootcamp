# Copy thành deploy.env (đã được .gitignore) rồi điền giá trị.
# Không commit deploy.env: file chứa secret.

# Azure
AZ_SUBSCRIPTION=""                 # để trống = dùng subscription hiện tại của az CLI
AZ_RESOURCE_GROUP="rg-ghas-bootcamp"
AZ_LOCATION="southeastasia"
PREFIX="ghas"                      # tiền tố tên resource, 2-12 ký tự [a-z0-9-]

# GitHub OAuth App (Settings > Developer settings > OAuth Apps)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Giới hạn IP truy cập frontend (khuyến nghị: app chứa lỗ hổng cố ý). Phân cách bằng dấu phẩy.
# Ví dụ: "203.0.113.10/32,198.51.100.0/24". Để trống = mở cho toàn Internet.
FRONTEND_ALLOWED_CIDRS=""

# Tuỳ chọn
ALWAYS_ON="false"                  # true = giữ 1 replica frontend/authn, tránh cold start
IMAGE_TAG=""                       # để trống = <git-sha>-<timestamp>
SKIP_BUILD="false"                 # true = dùng lại IMAGE_TAG đã có trong ACR
JWT_SECRET=""                      # để trống = lấy từ gallery-service/config.json (trùng secret hardcode trong authn-service)

# storage-service (tuỳ chọn, frontend hiện không dùng; cần AWS S3)
DEPLOY_STORAGE_SERVICE="false"
AWS_S3_BUCKET=""
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
